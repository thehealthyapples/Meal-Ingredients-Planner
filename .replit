modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["zip", "lsof", "nano", "nix-output-monitor"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5051
externalPort = 4200

[[ports]]
localPort = 5057
externalPort = 3003

[[ports]]
localPort = 5096
externalPort = 8000

[[ports]]
localPort = 5097
externalPort = 6800

[[ports]]
localPort = 5098
externalPort = 6000

[[ports]]
localPort = 5099
externalPort = 5000

[[ports]]
localPort = 5174
externalPort = 3001

[[ports]]
localPort = 5199
externalPort = 5173

[[ports]]
localPort = 5599
externalPort = 3002

[env]
PORT = "5000"

# NO [deployment] BLOCK — THIS IS DELIBERATE (REL2, 2026-07-11).
#
# THA does not deploy from Replit. Production is GitHub -> Render (auto-deploy on
# push to `main`), with Neon as the production database. RELEASE.md is the single
# canonical owner of that fact; see its "Deployment Configuration" section.
#
# This file previously declared `deploymentTarget = "autoscale"` with its own
# build/run commands. Nothing released from it, but it read as the deployment
# configuration, and it misled: REL1 diagnosed the ephemeral-uploads blocker
# against Replit autoscale — the wrong platform — because this block was here.
#
# Do not re-add it. `npm run verify:deployment-config` fails the release if it
# returns. If THA ever genuinely adopts a second deployment target, that is an
# architectural decision: declare it in RELEASE.md first, then update the gate.

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "lsof -ti :5000 | xargs kill -9 2>/dev/null; sleep 1; npm run dev"
waitForPort = 5000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
