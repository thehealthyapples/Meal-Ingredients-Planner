+const labelledQueries = filters.dietaryPrefix
+  ? rawQueries.slice(0, 3).map(q => `${filters.dietaryPrefix} ${q}`)
+  : rawQueries.slice(0, 5);
+
+const queries = filters.dietaryPrefix
+  ? [...labelledQueries, ...BREAKFAST_CONCEPT_QUERIES]
+  : labelledQueries;
+```
