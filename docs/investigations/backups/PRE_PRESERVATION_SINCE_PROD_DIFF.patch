+  const reuseSuggestions = weeklyReuseMap && currentMealName
+    ? allSuggestions.filter((s) => {
+        const mealNames = weeklyReuseMap.get(normaliseForReuse(s.ingredient))?.filter(n => n !== currentMealName);
