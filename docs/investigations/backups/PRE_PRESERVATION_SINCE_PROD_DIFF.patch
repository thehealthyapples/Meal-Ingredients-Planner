+      })
+    : allSuggestions;
+  const selectedReuse = reuseSuggestions.slice(0, 1);
+  const selectedDiscovery = discoverySuggestions.slice(0, 5 - selectedReuse.length);
+  return [...selectedReuse, ...selectedDiscovery];
