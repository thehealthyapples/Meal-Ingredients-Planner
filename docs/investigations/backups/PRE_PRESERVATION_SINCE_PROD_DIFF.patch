+
+  const fishMatch: MealMatch = {
+    template: fishShell as MealTemplate,
+    sharedIngredients: ['rice'],
+    memberChanges: [],
+    swapsNeeded: [],
+    extraPrepMinutes: 0,
+    fitScore: 95,
+    scoreBreakdown,
+    explanation: 'Fish match',
+  };
+
+  const cheeseShell: Partial<MealTemplate> = {
+    id: 1004,
+    name: 'Cheese Pasta Bake',
+    category: 'dinner',
+    cuisine: null,
