+
+  // Test 8b: Vegan household — fish shell blocked too
+  const fishShell: Partial<MealTemplate> = {
+    id: 1003,
+    name: 'Salmon Bowl',
+    category: 'dinner',
+    cuisine: null,
+    description: null,
+    imageUrl: null,
+    sharedBaseComponents: ['rice'],
