+  │
+  ├─ getHouseholdForUser(req.user.id)
+  │
+  ├─ storage.getHouseholdEaters(householdId) ← ✓ household_eaters
+  ├─ storage.getWeekEaterOverrides(week.id)  ← plannerWeekEaterOverrides
+  │
