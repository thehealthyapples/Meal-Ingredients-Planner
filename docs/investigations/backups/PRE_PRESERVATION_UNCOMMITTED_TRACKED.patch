-        next.add(key);
-      }
-      return next;
-    });
-  }
-
-  const statusMessage = isComplete
-    ? "You've hit 30 plants this week — brilliant variety."
-    : isOnTrack
-      ? `${WEEKLY_PLANT_TARGET - plantCount} more plants to reach 30 this week.`
