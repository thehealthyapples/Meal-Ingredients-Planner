-// ─── Helpers ─────────────────────────────────────────────────────────────────
-
-function toDisplayName(key: string): string {
-  return key.replace(/\b\w/g, (c) => c.toUpperCase());
-}
-
-function stripLeadingQuantity(raw: string): string {
-  return raw
-    .toLowerCase()
-    .replace(/^\d+(\.\d+)?\s*(g|kg|ml|l|tsp|tbsp|cup|cups|oz|lb|lbs|x)?\s*/i, "")
-    .replace(/^[½⅓⅔¼¾⅕⅖⅗⅘⅙⅚⅛⅜⅝⅞]\s*/, "")
-    .trim();
-}
